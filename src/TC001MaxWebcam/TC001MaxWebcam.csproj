<Project Sdk="Microsoft.NET.Sdk">

	<!--
	TC001MaxWebcam.exe: creates / removes the "TC001 Max Thermal Webcam" virtual camera, shows its
	status and reads / writes settings.json. Replaces VCamNetSample's WinForms "driver" app
	(Copyright (c) 2024-2026 Simon Mourier, MIT License, see ..\..\THIRD_PARTY_NOTICES.txt) with a
	console tool. Framework-dependent (.NET 10).
	-->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<AssemblyName>TC001MaxWebcam</AssemblyName>
		<RootNamespace>TC001MaxWebcam.Cli</RootNamespace>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>false</SelfContained>
		<Platforms>x64</Platforms>
		<PlatformTarget>x64</PlatformTarget>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
		<Version>1.4.0</Version>
		<Product>TC001 Max Thermal Webcam</Product>
		<Description>TC001 Max Thermal Webcam control tool (based on VCamNetSample by Simon Mourier, MIT)</Description>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="..\TC001MaxWebcam.Source\Shared.cs" Link="Shared.cs" />
		<!-- settings, and device discovery for status (the camera is never opened here) -->
		<Compile Include="..\TC001MaxWebcam.Source\Core\*.cs" LinkBase="Core" />
		<Compile Include="..\TC001MaxWebcam.Source\Usb\*.cs" LinkBase="Usb" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="DirectNCore" Version="1.18.0" />
	</ItemGroup>

</Project>
